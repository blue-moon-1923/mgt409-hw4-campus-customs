# Copy this file to .env in this folder and fill in your own values.
# .env is ignored by git and must never be committed.

# Required. Portkey gateway key used to reach the model.
PORTKEY_API_KEY=your-key-here

# Optional. Signs session cookies so a backend restart does not sign everyone
# out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CAMPUS_CUSTOMS_SESSION_SECRET=generate-a-long-random-value

# Optional overrides. The defaults below are what the app uses.
MODEL_NAME=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
